# Nothing secret belongs here; refuse it if it ever lands.
*.pem
*.secret
*.key
# Token files (`github-pat`, `gh-pat.txt`). Was `*-pat*` until 2026-09-12, which also matched every
# `cap-pattern` requirement file and silently kept three of them out of the commit — see lint-ignored.
*-pat
*-pat.*

# Local agent context — injectable, never committed (ADR-0020).
AGENTS.local.md
.agents/

# Run artifacts. A conformance run's output is evidence, not source: it is cited by
# digest and reproduced, never committed.
output/
scratch/
*.report.json

# Consumed peers are vendored deliberately and per-peer; nothing here is auto-pulled.
substrate/**/build/

# Python bytecode (suite runs set PYTHONDONTWRITEBYTECODE; a host-side test run does not).
__pycache__/
