    "handlers": []
  },
  "unreachable": {
    "class": "§3.3 satisfaction mode — not drivable by a conformance client (the specification's own classification)",
    "why_no_proxy": "any wire input that produces a 500 on a conformant peer is a peer bug by definition, so no suite can rely on one existing; fault injection needs the peer's cooperation, which is a host-seam, not the wire.",
    "discharged_by": [
      "a source audit of every 500 emit site at a named content digest or release tag",
      "a host-seam fault-injection hook, where a peer's harness offers one"
    ],
    "reported_as": "SKIP, naming §3.3's satisfaction mode — never PASS"
  },
  "arm": [
    {
      "name": "non-conformant-witness",
      "kind": "non-conformant",
      "given": "a peer whose store layer surfaces an OS error string as the code, or maps every internal failure to `io_error`",
      "expect": "500 with `code` = 'ENOSPC' or `io_error` for a store failure",
      "why": "the two defects the 0.8.2.6/0.8.2.8 revisions name: an undefined spelling, and the two specific codes treated as interchangeable."
    }
  ],
  "notes": {
    "peer_attributable": true,
